# ── Python Backend ────────────────────────────────────────────────────────────
PYTHON_API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Gemini ────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_FILE_MODEL=gemini-2.5-pro
GEMINI_MODEL_PRO=gemini-2.5-pro
REPORT_MAX_TOKENS=8192
GEMINI_RETRY_LIMIT=3
GEMINI_RETRY_DELAY=60

# ── Obsidian Knowledge Vault ──────────────────────────────────────────────────
OBSIDIAN_VAULT_PATH=obsidian_knowledge
OBSIDIAN_DEFAULT_VAULT=health_region_10
OBSIDIAN_ENABLED=true
OBSIDIAN_SEARCH_THRESHOLD=0.1
OBSIDIAN_RAW_PDF_PATH=obsidian_raw_pdf
OBSIDIAN_PDF_MINIO_PREFIX=obsidian-pdfs

# ── CrewAI / Tracing ──────────────────────────────────────────────────────────
CREWAI_TRACING_ENABLED=false
OTEL_SDK_DISABLED=true

# ── PostgreSQL (shared DB with Python backend) ────────────────────────────────
DATABASE_URL=postgresql://postgres:your-db-password@localhost:5432/musyadata
DATABASE_SSL=false

# ── MinIO ─────────────────────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=your-minio-access-key
MINIO_SECRET_KEY=your-minio-secret-key
MINIO_BUCKET=fileapa
MINIO_APA_BUCKET=apa-docs

# ── Auth ──────────────────────────────────────────────────────────────────────
# สร้างด้วย: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ต้องยาวอย่างน้อย 32 ตัวอักษร
JWT_SECRET=generate-with-node-crypto-randomBytes-48-hex

# ── Internal API Key (ต้องตรงกับ chatapi.python/.env) ──────────────────────────
# สร้างด้วย: python -c "import secrets; print(secrets.token_hex(32))"
INTERNAL_API_KEY=generate-with-secrets-token-hex-32

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
LOG_LEVEL=info
